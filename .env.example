# Copy this file to .env and fill it in. .env is never committed.

PORT=3000

# Password for the studio desk at /admin. Required: the desk stays locked without it.
ADMIN_PASSWORD=

# Signs the desk's login cookie. Use a long random string in production
# (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
# If it is empty, a new one is made at every start and everyone is signed out.
SESSION_SECRET=

# Where the database and uploaded images live. Point it at a persistent disk in production.
DATA_DIR=data

# Optional: email the studio when an enquiry arrives. Leave SMTP_HOST empty to switch it off.
# For Gmail, use smtp.gmail.com, port 465 and an app password (not the account password).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=contentbook7@gmail.com

# Set to production when deployed (secure cookies, trusts the host's proxy).
NODE_ENV=development
